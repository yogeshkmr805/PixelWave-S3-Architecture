{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowPixelWaveAccountOnly",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::pixelwave-assets-228145980186-ap-south-1-an",
                "arn:aws:s3:::pixelwave-assets-228145980186-ap-south-1-an/*"
            ],
            "Condition": {
                "StringNotEquals": {
                    "aws:PrincipalAccount": "228145980186"
                }
            }
        },
        {
            "Sid": "DenyUnencryptedUploads",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::pixelwave-assets-228145980186-ap-south-1-an/*",
            "Condition": {
                "StringNotEquals": {
                    "s3:x-amz-server-side-encryption": "aws:kms"
                }
            }
        },
        {
            "Sid": "DenyWrongKMSKey",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::pixelwave-assets-228145980186-ap-south-1-an/*",
            "Condition": {
                "StringNotEquals": {
                    "s3:x-amz-server-side-encryption-aws-kms-key-id": "arn:aws:kms:ap-south-1:228145980186:key/fb18a49a-cb76-44a9-b5a2-8cad7f50a416"
                }
            }
        }
    ]
}